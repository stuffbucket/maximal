{
  "name": "maximal-client",
  "productName": "Maximal",
  "version": "0.0.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "build:core": "bun build --compile node_modules/@stuffbucket/maximal-core/src/main.ts --outfile resources/bin/maximal-core",
