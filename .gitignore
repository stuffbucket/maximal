node_modules/
dist/
# Astro per-project cache (regenerated on build)
.astro/
# build/ holds two flavors: compiled output (bun-build artifacts —
# ignore) and source-controlled packaging sources under build/macos/
# (app icon), build/homebrew/, build/linux/ and build/windows/. The pattern below
# ignores everything in build/ except those source trees.
build/*
!build/macos/
!build/homebrew/
!build/windows/
!build/linux/
SBOM.cdx.json
*.log
.DS_Store
.env
.env.local
.env.*.local

# bun
.bun/

# editor
.vscode/
.idea/
*.swp

# local env
*.local
# Non-Claude agent tools AGENTS.md points at (opencode, Aider)
.aider*
.opencode/plans
.opencode/package-lock.json
# eslint cache
.eslintcache
.claude
# Playwright output (tests/e2e)
test-results/
playwright-report/
# Stryker mutation testing
.stryker-tmp/
reports/
# bun --compile temp executables (live in cwd, ~60MB each)
.*.bun-build
dist-release/

*.dmg

# Generated UI embed manifest (regenerated by scripts/gen-ui-embed.ts)
src/generated/
# Per-worktree Tauri development overrides (regenerated by app:dev)
shell/src-tauri/tauri.dev.conf.json

# Storybook (packages/storybook): staged UI + static build
packages/storybook/.ui/
packages/storybook/storybook-static/
