---
import SurveyBars from "../components/SurveyBars.astro"
import StarButton from "../components/StarButton.astro"
import { getDownloadInfo } from "../lib/downloads"
import "../styles/global.css"

const { macDmg, versionLabel, releasesUrl, repoUrl } = await getDownloadInfo()
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const guideUrl = `${base}/guide`

const SOURCE = {
  text: "AI in Design Report 2026, stateofaidesign.com",
  href: "https://stateofaidesign.com/",
}

// Coding & dev tools designers use (2026). Claude Code is the tool they reach
// for; GitHub Copilot is the plan they pay for — the wedge, made visible.
const codingTools = [
  { label: "Claude Code", value: 65, tone: "brand" as const },
  { label: "Cursor", value: 39 },
  { label: "Lovable", value: 19 },
  { label: "v0 by Vercel", value: 17 },
  { label: "OpenAI Codex", value: 15 },
  { label: "Company internal tools", value: 12 },
  { label: "GitHub Copilot", value: 9, tone: "accent" as const, note: "the plan you pay for" },
  { label: "Replit", value: 8 },
  { label: "Bolt", value: 2 },
]

const ogTitle = "maximal for design teams · the tools they use, the plan you have"
const ogDescription =
  "Your designers already use Claude Code and Codex. maximal runs them on the GitHub Copilot plan your company already pays for."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/commissioner-latin.woff2" crossorigin />
    <title>{ogTitle}</title>
    <meta name="description" content={ogDescription} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <StarButton />

    <header class="topbar">
      <a class="topbar__home" href={`${base}/`}>
        <span class="topbar__mark" aria-hidden="true">m</span>
        <span class="topbar__word">maximal</span>
      </a>
      <span class="topbar__tag">for design teams</span>
    </header>

    <main id="main" class="dt">
      <!-- Hero: left type + CTAs, a crimson brand panel carrying the wedge. -->
      <section class="dt-hero">
        <div class="dt-hero__lede">
          <h1 class="dt-h1">
            The tools your designers use.<br />
            <span class="ink-brand">The plan you already have.</span>
          </h1>
          <p class="dt-hero__sub">
            Claude Code, Codex, and the rest — on your company's GitHub Copilot
            plan.
          </p>
          <div class="dt-cta">
            <a class="btn btn--primary" data-os="mac" href={macDmg} rel="noopener">
              <span class="btn-label">Download for macOS</span>
              {versionLabel && <span class="btn-meta" data-version-pill>{versionLabel}</span>}
            </a>
            <a class="btn" href={guideUrl}>
              <span class="btn-label">Read the guide</span>
              <span class="btn-meta" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <aside class="dt-stat" aria-label="The gap the 2026 report exposes">
          <p class="dt-stat__fig"><b>65%</b> use Claude Code</p>
          <p class="dt-stat__fig dt-stat__fig--dim"><b>9%</b> use Copilot's own app</p>
          <p class="dt-stat__line">They reach for one. You pay for the other.</p>
        </aside>
      </section>

      <!-- Evidence -->
      <section class="dt-block">
        <p class="dt-eyebrow">Your designers already chose</p>
        <h2 class="dt-h2">Coding agents are core design tooling now.</h2>
        <p class="dt-lede">
          And it isn't the one you're paying for. Designers run an average of
          seven AI tools today, up from three a year ago.
        </p>
        <div class="dt-chart">
          <SurveyBars
            title="Coding &amp; dev tools designers use (2026)"
            series={codingTools}
            source={SOURCE}
          />
        </div>
      </section>

      <!-- The gap -->
      <section class="dt-block dt-block--wedge">
        <h2 class="dt-h2">But the budget lives with engineering.</h2>
        <p class="dt-prose">
          Designers don't hold API keys or budgets, so each tool means its own
          subscription. <b>maximal points those tools at the Copilot plan your
          company already has.</b>
        </p>
      </section>

      <!-- Mechanism -->
      <section class="dt-block">
        <h2 class="dt-h2">Switch it on. Keep working.</h2>
        <p class="dt-prose">
          Turn on the tools your designers use, and maximal runs them on your
          Copilot plan.
        </p>
        <ul class="dt-points">
          <li><b>No design-side budget.</b> They use the tools they know; maximal handles the connection.</li>
          <li><b>No procurement.</b> It runs on the Copilot seats you already pay for.</li>
          <li><b>No second bill.</b> The plan is the one you already have.</li>
        </ul>
      </section>

      <!-- Close -->
      <section class="dt-close">
        <h2 class="dt-h2 dt-h2--close">Give your team what they already reached for.</h2>
        <div class="dt-cta">
          <a class="btn btn--primary" data-os="mac" href={macDmg} rel="noopener">
            <span class="btn-label">Download for macOS</span>
            {versionLabel && <span class="btn-meta" data-version-pill>{versionLabel}</span>}
          </a>
          <a class="btn" href={guideUrl}>
            <span class="btn-label">Read the guide</span>
            <span class="btn-meta" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="dt-footer">
      <a href={`${base}/`}>maximal</a>
      <a href={guideUrl}>Guide</a>
      <a href={repoUrl} rel="noopener">GitHub</a>
      <a href={releasesUrl} rel="noopener">Releases</a>
    </footer>

    <script>
      import "../lib/hydrate-downloads"
    </script>

    <style>
      /* Editorial, asymmetric, brand-anchored. Type + space carry it; the one
         crimson panel is the identity moment. No card soup, no drop shadows. */
      .topbar,
      .dt,
      .dt-footer {
        max-width: 64rem;
        margin: 0 auto;
      }
      .topbar {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 1.5rem 1.5rem 0;
      }
      .topbar__home {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
      }
      .topbar__mark {
        display: inline-grid;
        place-items: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 6px;
        background: var(--brand);
        color: var(--brand-ink);
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1rem;
      }
      .topbar__word {
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }
      .topbar__tag {
        font-family: var(--sans);
        font-size: 0.8rem;
        color: var(--text-muted);
        padding-left: 0.85rem;
        border-left: 1px solid var(--border);
      }

      .dt {
        padding: 3.5rem 1.5rem 4rem;
        display: flex;
        flex-direction: column;
        gap: clamp(3.5rem, 8vw, 6rem);
      }

      /* ===== Hero ===== */
      .dt-hero {
        display: grid;
        grid-template-columns: 1.25fr 0.75fr;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
      }
      @media (max-width: 820px) {
        .dt-hero {
          grid-template-columns: 1fr;
          gap: 2.5rem;
        }
      }
      .dt-h1 {
        font-family: var(--serif);
        font-weight: 600;
        font-optical-sizing: auto;
        font-variation-settings: "SOFT" 30, "opsz" 110;
        font-size: clamp(2.6rem, 6vw, 4.4rem);
        line-height: 1.02;
        letter-spacing: -0.03em;
        color: var(--text);
        margin: 0;
      }
      .dt-hero__sub {
        font-family: var(--sans);
        font-size: 1.15rem;
        line-height: 1.55;
        color: var(--text-body);
        max-width: 30rem;
        margin: 1.4rem 0 0;
      }
      .dt-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.9rem;
      }

      /* The crimson identity moment — the wedge, in the brand's own voice. */
      .dt-stat {
        background: var(--brand);
        color: var(--brand-ink);
        border-radius: clamp(14px, 2vw, 20px);
        padding: clamp(1.6rem, 3vw, 2.2rem);
      }
      .dt-stat__fig {
        font-family: var(--sans);
        font-size: 1.05rem;
        margin: 0 0 0.5rem;
        color: var(--brand-ink);
      }
      .dt-stat__fig b {
        font-family: var(--serif);
        font-weight: 700;
        font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
        font-size: 2.9rem;
        line-height: 1;
        margin-right: 0.4rem;
        letter-spacing: -0.02em;
      }
      .dt-stat__fig--dim {
        opacity: 0.62;
      }
      .dt-stat__line {
        font-family: var(--serif);
        font-size: 1.1rem;
        line-height: 1.3;
        margin: 1.1rem 0 0;
        padding-top: 1.1rem;
        border-top: 1px solid color-mix(in srgb, var(--brand-ink) 28%, transparent);
        color: var(--brand-ink);
      }

      /* ===== Blocks — typographic sections, not cards ===== */
      .dt-eyebrow {
        font-family: var(--sans);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brand-lit);
        margin: 0 0 0.6rem;
      }
      .dt-h2 {
        font-family: var(--serif);
        font-weight: 600;
        font-size: clamp(1.7rem, 3.8vw, 2.6rem);
        line-height: 1.08;
        letter-spacing: -0.025em;
        color: var(--text);
        margin: 0;
        max-width: 20ch;
      }
      .dt-lede,
      .dt-prose {
        font-family: var(--sans);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--text-body);
        max-width: 40rem;
        margin: 1rem 0 0;
      }
      .dt-prose b {
        color: var(--text);
        font-weight: 600;
      }

      .dt-block--wedge {
        border-left: 3px solid var(--brand);
        padding-left: clamp(1.25rem, 3vw, 2rem);
      }

      /* Chart: a quiet framed surface — hairline, no drop shadow. */
      .dt-chart {
        margin-top: 2rem;
        max-width: 40rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.75rem;
      }

      .dt-points {
        list-style: none;
        margin: 1.75rem 0 0;
        padding: 0;
        display: grid;
        gap: 1rem;
        max-width: 44rem;
      }
      .dt-points li {
        font-family: var(--sans);
        font-size: 1.02rem;
        line-height: 1.5;
        color: var(--text-body);
        padding-left: 1.4rem;
        position: relative;
      }
      .dt-points li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.6em;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 2px;
        background: var(--brand);
      }
      .dt-points b {
        color: var(--text);
        font-weight: 600;
      }

      /* ===== Close ===== */
      .dt-close {
        border-top: 1px solid var(--border);
        padding-top: clamp(3rem, 6vw, 4rem);
      }
      .dt-h2--close {
        font-size: clamp(2rem, 5vw, 3.2rem);
        max-width: 18ch;
      }
      .dt-close .dt-cta {
        margin-top: 1.75rem;
      }

      .dt-footer {
        padding: 2rem 1.5rem 3rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        font-family: var(--sans);
        font-size: 0.9rem;
      }
      .dt-footer a {
        color: var(--text-muted);
        text-decoration: none;
      }
      .dt-footer a:hover {
        color: var(--text);
      }
    </style>
  </body>
</html>
