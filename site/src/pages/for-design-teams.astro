---
import SurveyBars from "../components/SurveyBars.astro"
import StarButton from "../components/StarButton.astro"
import { getDownloadInfo } from "../lib/downloads"
import "../styles/global.css"

const { macDmg, versionLabel, releasesUrl, repoUrl } = await getDownloadInfo()
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const guideUrl = `${base}/guide`

const SOURCE = {
  text: "AI in Design Report 2026, stateofaidesign.com",
  href: "https://stateofaidesign.com/",
}

const codingTools = [
  { label: "Claude Code", value: 65, tone: "brand" as const },
  { label: "Cursor", value: 39 },
  { label: "Lovable", value: 19 },
  { label: "v0 by Vercel", value: 17 },
  { label: "OpenAI Codex", value: 15 },
  { label: "Company internal tools", value: 12 },
  { label: "GitHub Copilot", value: 9, tone: "accent" as const, note: "the plan you have" },
  { label: "Replit", value: 8 },
  { label: "Bolt", value: 2 },
]

// The rolodex reel — the tools a designer already reaches for. First item is
// repeated at the end for a seamless loop.
const reel = ["Claude Code", "Cursor", "Codex", "opencode", "v0", "Lovable"]

const ogTitle = "maximal for designers · the tools you love, the plan you have"
const ogDescription =
  "You already use Claude Code and Codex. maximal runs them on your company's GitHub Copilot plan — no keys to request, no sign-off to wait on."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/commissioner-latin.woff2" crossorigin />
    <title>{ogTitle}</title>
    <meta name="description" content={ogDescription} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <StarButton />

    <header class="topbar">
      <a class="topbar__home" href={`${base}/`}>
        <span class="topbar__mark" aria-hidden="true">m</span>
        <span class="topbar__word">maximal</span>
      </a>
      <span class="topbar__tag">for designers</span>
    </header>

    <main id="main" class="dt">
      <!-- Hero — spoken to the designer. -->
      <section class="dt-hero">
        <div class="dt-hero__lede">
          <h1 class="dt-h1">
            The tools you love.<br />
            <span class="ink-brand">The plan your company already has.</span>
          </h1>
          <p class="dt-hero__sub">
            You already reach for Claude Code and Codex. maximal runs them on your
            company's GitHub Copilot plan — no keys to request, no budget to
            approve.
          </p>
          <div class="dt-cta">
            <a class="btn btn--primary" data-os="mac" href={macDmg} rel="noopener">
              <span class="btn-label">Download for macOS</span>
              {versionLabel && <span class="btn-meta" data-version-pill>{versionLabel}</span>}
            </a>
            <a class="btn" href={guideUrl}>
              <span class="btn-label">Read the guide</span>
              <span class="btn-meta" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <aside class="dt-stat" aria-label="The gap the 2026 report exposes">
          <p class="dt-stat__fig"><b>65%</b> use Claude Code</p>
          <p class="dt-stat__fig dt-stat__fig--dim"><b>9%</b> use Copilot's own app</p>
          <p class="dt-stat__line">You reach for one. Your company pays for the other.</p>
        </aside>
      </section>

      <!-- Evidence -->
      <section class="dt-block">
        <p class="dt-eyebrow">You're not the only one</p>
        <h2 class="dt-h2">Coding agents are core design tooling now.</h2>
        <p class="dt-lede">
          Designers run seven AI tools on average, up from three last year — and
          the one they reach for isn't the one their company pays for.
        </p>
        <div class="dt-chart">
          <SurveyBars
            title="Coding &amp; dev tools designers use (2026)"
            series={codingTools}
            source={SOURCE}
          />
        </div>
      </section>

      <!-- The rolodex moment -->
      <section class="dt-reel-block">
        <p class="dt-reel__lead">So keep using</p>
        <span class="sr-only">Claude Code, Cursor, Codex, opencode, v0, Lovable, and more.</span>
        <div class="reel" aria-hidden="true">
          <ul class="reel__list" id="reel">
            {reel.map((t) => <li>{t}</li>)}
            <li>{reel[0]}</li>
          </ul>
        </div>
        <p class="dt-reel__tail">
          maximal runs it on the Copilot plan your company already has.
        </p>
      </section>

      <!-- The blockers, removed -->
      <section class="dt-block">
        <ul class="dt-triad">
          <li>No keys to request.</li>
          <li>No subscription to expense.</li>
          <li>No sign-off to wait on.</li>
        </ul>
      </section>

      <!-- Close — the designer starts, then spreads it. -->
      <section class="dt-close">
        <h2 class="dt-h2 dt-h2--close">Start now. No one has to sign off.</h2>
        <p class="dt-lede">
          Download it, point your tools at your Copilot plan, and get back to
          work — then tell the rest of your team.
        </p>
        <div class="dt-cta">
          <a class="btn btn--primary" data-os="mac" href={macDmg} rel="noopener">
            <span class="btn-label">Download for macOS</span>
            {versionLabel && <span class="btn-meta" data-version-pill>{versionLabel}</span>}
          </a>
          <a class="btn" href={guideUrl}>
            <span class="btn-label">Read the guide</span>
            <span class="btn-meta" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="dt-footer">
      <a href={`${base}/`}>maximal</a>
      <a href={guideUrl}>Guide</a>
      <a href={repoUrl} rel="noopener">GitHub</a>
      <a href={releasesUrl} rel="noopener">Releases</a>
    </footer>

    <script>
      import "../lib/hydrate-downloads"
    </script>
    <script is:inline>
      // Rolodex reel: step one tool per beat, snap back over the duplicate for a
      // seamless loop. Reduced motion is a contract — leave it on the first item.
      (function () {
        var reel = document.getElementById("reel")
        if (!reel) return
        if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
        var real = reel.children.length - 1 // last is the duplicate first
        var n = 0
        setInterval(function () {
          n++
          reel.style.transition = "transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)"
          reel.style.setProperty("--n", String(n))
          if (n === real) {
            setTimeout(function () {
              reel.style.transition = "none"
              n = 0
              reel.style.setProperty("--n", "0")
            }, 640)
          }
        }, 2000)
      })()
    </script>

    <style>
      .topbar,
      .dt,
      .dt-footer {
        max-width: 64rem;
        margin: 0 auto;
      }

      /* Tightened lockup: compact mark, snug wordmark, thin fixed-height rule. */
      .topbar {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 1.5rem 1.5rem 0;
      }
      .topbar__home {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        text-decoration: none;
      }
      .topbar__mark {
        display: inline-grid;
        place-items: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 5px;
        background: var(--brand);
        color: var(--brand-ink);
        font-family: var(--serif);
        font-weight: 700;
        font-size: 0.95rem;
        line-height: 1;
      }
      .topbar__word {
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }
      .topbar__tag {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--sans);
        font-size: 0.8rem;
        color: var(--text-muted);
      }
      .topbar__tag::before {
        content: "";
        width: 1px;
        height: 0.9rem;
        background: var(--border-strong);
      }

      .dt {
        padding: 3.5rem 1.5rem 4rem;
        display: flex;
        flex-direction: column;
        gap: clamp(3.5rem, 8vw, 6rem);
      }

      /* ===== Hero ===== */
      .dt-hero {
        display: grid;
        grid-template-columns: 1.25fr 0.75fr;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
      }
      @media (max-width: 820px) {
        .dt-hero {
          grid-template-columns: 1fr;
          gap: 2.5rem;
        }
      }
      .dt-h1 {
        font-family: var(--serif);
        font-weight: 600;
        font-optical-sizing: auto;
        font-variation-settings: "SOFT" 30, "opsz" 110;
        font-size: clamp(2.6rem, 6vw, 4.4rem);
        line-height: 1.02;
        letter-spacing: -0.03em;
        color: var(--text);
        margin: 0;
      }
      .dt-hero__sub {
        font-family: var(--sans);
        font-size: 1.15rem;
        line-height: 1.55;
        color: var(--text-body);
        max-width: 30rem;
        margin: 1.4rem 0 0;
      }
      .dt-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.9rem;
      }

      .dt-stat {
        background: var(--brand);
        color: var(--brand-ink);
        border-radius: clamp(14px, 2vw, 20px);
        padding: clamp(1.6rem, 3vw, 2.2rem);
      }
      .dt-stat__fig {
        font-family: var(--sans);
        font-size: 1.05rem;
        margin: 0 0 0.5rem;
        color: var(--brand-ink);
      }
      .dt-stat__fig b {
        font-family: var(--serif);
        font-weight: 700;
        font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
        font-size: 2.9rem;
        line-height: 1;
        margin-right: 0.4rem;
        letter-spacing: -0.02em;
      }
      .dt-stat__fig--dim {
        opacity: 0.62;
      }
      .dt-stat__line {
        font-family: var(--serif);
        font-size: 1.1rem;
        line-height: 1.3;
        margin: 1.1rem 0 0;
        padding-top: 1.1rem;
        border-top: 1px solid color-mix(in srgb, var(--brand-ink) 28%, transparent);
        color: var(--brand-ink);
      }

      /* ===== Blocks ===== */
      .dt-eyebrow {
        font-family: var(--sans);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brand-lit);
        margin: 0 0 0.6rem;
      }
      .dt-h2 {
        font-family: var(--serif);
        font-weight: 600;
        font-size: clamp(1.7rem, 3.8vw, 2.6rem);
        line-height: 1.08;
        letter-spacing: -0.025em;
        color: var(--text);
        margin: 0;
        max-width: 20ch;
      }
      .dt-lede {
        font-family: var(--sans);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--text-body);
        max-width: 40rem;
        margin: 1rem 0 0;
      }

      .dt-chart {
        margin-top: 2rem;
        max-width: 40rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.75rem;
      }

      /* ===== Rolodex reel ===== */
      .dt-reel-block {
        text-align: left;
      }
      .dt-reel__lead {
        font-family: var(--sans);
        font-size: 1.05rem;
        color: var(--text-muted);
        margin: 0 0 0.4rem;
      }
      .reel {
        height: 1.12em;
        overflow: hidden;
        font-family: var(--serif);
        font-weight: 700;
        font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
        font-size: clamp(2.8rem, 9vw, 6rem);
        line-height: 1.12;
        letter-spacing: -0.03em;
        color: var(--brand-lit);
      }
      .reel__list {
        list-style: none;
        margin: 0;
        padding: 0;
        transform: translateY(calc(var(--n, 0) * -1.12em));
      }
      .reel__list li {
        height: 1.12em;
      }
      .dt-reel__tail {
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(1.3rem, 3vw, 1.9rem);
        line-height: 1.25;
        color: var(--text);
        max-width: 24ch;
        margin: 0.5rem 0 0;
      }

      /* ===== Blockers triad ===== */
      .dt-triad {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2.25rem;
      }
      .dt-triad li {
        font-family: var(--serif);
        font-weight: 600;
        font-size: clamp(1.25rem, 2.6vw, 1.7rem);
        letter-spacing: -0.015em;
        color: var(--text);
        position: relative;
        padding-left: 1.4rem;
      }
      .dt-triad li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.62em;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 2px;
        background: var(--brand);
      }

      /* ===== Close ===== */
      .dt-close {
        border-top: 1px solid var(--border);
        padding-top: clamp(3rem, 6vw, 4rem);
      }
      .dt-h2--close {
        font-size: clamp(2rem, 5vw, 3.2rem);
        max-width: 18ch;
      }
      .dt-close .dt-cta {
        margin-top: 1.75rem;
      }

      .dt-footer {
        padding: 2rem 1.5rem 3rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        font-family: var(--sans);
        font-size: 0.9rem;
      }
      .dt-footer a {
        color: var(--text-muted);
        text-decoration: none;
      }
      .dt-footer a:hover {
        color: var(--text);
      }
    </style>
  </body>
</html>
