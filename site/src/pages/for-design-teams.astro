---
import SurveyBars from "../components/SurveyBars.astro"
import StarButton from "../components/StarButton.astro"
import { getDownloadInfo } from "../lib/downloads"
import "../styles/global.css"

const { macDmg, versionLabel, releasesUrl, repoUrl } = await getDownloadInfo()
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const guideUrl = `${base}/guide`

const SOURCE = {
  text: "AI in Design Report 2026, stateofaidesign.com",
  href: "https://stateofaidesign.com/",
}

// Trimmed to the six that tell the story: Claude Code dominant, Copilot low.
const codingTools = [
  { label: "Claude Code", value: 65, tone: "brand" as const },
  { label: "Cursor", value: 39 },
  { label: "Lovable", value: 19 },
  { label: "v0 by Vercel", value: 17 },
  { label: "OpenAI Codex", value: 15 },
  { label: "GitHub Copilot", value: 9, tone: "accent" as const, note: "the plan you have" },
]

const reel = ["Claude Code", "Cursor", "Codex", "opencode", "v0", "Lovable"]

const ogTitle = "maximal for designers · the tools you love, the plan you have"
const ogDescription =
  "You already use Claude Code and Codex. maximal runs them on your company's GitHub Copilot plan. No keys to request, no sign-off to wait on."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/commissioner-latin.woff2" crossorigin />
    <title>{ogTitle}</title>
    <meta name="description" content={ogDescription} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <StarButton />

    <header class="topbar">
      <a class="topbar__home" href={`${base}/`}>
        <span class="topbar__mark" aria-hidden="true">m</span>
        <span class="topbar__word">maximal</span>
      </a>
      <span class="topbar__tag">for designers</span>
    </header>

    <main id="main" class="dt">
      <!-- Hero — full-width statement, the tile as the initial "m". -->
      <section class="dt-hero">
        <h1 class="dt-h1">
          <span class="hz-tile" aria-hidden="true">
            <svg viewBox="0 0 100 100">
              <rect width="100" height="100" rx="23" fill="#c8334a"></rect>
              <text class="hz-tile__m" x="50" y="66" text-anchor="middle" fill="#f4ead4">m</text>
            </svg></span
          ><span class="sr-only">m</span>aximize the AI tools you love
          <span class="ink-brand">on the Copilot plan that's already paid for.</span>
        </h1>
        <p class="dt-hero__sub">
          You already reach for Claude Code and Codex. No new keys, no new bill.
        </p>
        <div class="dt-cta">
          <a class="btn btn--primary" data-os="mac" href={macDmg} rel="noopener">
            <span class="btn-label">Download for macOS</span>
            {versionLabel && <span class="btn-meta" data-version-pill>{versionLabel}</span>}
          </a>
          <a class="btn" href={guideUrl}>
            <span class="btn-label">Read the guide</span>
            <span class="btn-meta" aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <!-- Evidence — text beside a compact chart. -->
      <section class="dt-evidence">
        <div class="dt-evidence__text">
          <p class="dt-eyebrow">You're not the only one</p>
          <h2 class="dt-h2">Coding agents are core design tooling now.</h2>
          <p class="dt-lede">
            Designers run seven AI tools on average, up from three last year. The
            one they reach for isn't the one their company pays for.
          </p>
        </div>
        <div class="dt-chart">
          <SurveyBars
            title="Coding &amp; dev tools designers use (2026)"
            series={codingTools}
            source={SOURCE}
          />
        </div>
      </section>

      <!-- The rolodex moment -->
      <section class="dt-reel-block">
        <p class="dt-reel__lead">So keep using</p>
        <span class="sr-only">Claude Code, Cursor, Codex, opencode, v0, Lovable, and more.</span>
        <div class="reel" aria-hidden="true">
          <ul class="reel__list" id="reel">
            {reel.map((t) => <li>{t}</li>)}
            <li>{reel[0]}</li>
          </ul>
        </div>
        <p class="dt-reel__tail">
          maximal runs it on the Copilot plan your company already has.
        </p>
      </section>

      <!-- Blockers, removed -->
      <section class="dt-block">
        <ul class="dt-triad">
          <li>No keys to request.</li>
          <li>No out-of-pocket subscription.</li>
          <li>No sign-off to wait on.</li>
        </ul>
      </section>

      <!-- Close -->
      <section class="dt-close">
        <h2 class="dt-h2 dt-h2--close">Start now. No one has to sign off.</h2>
        <p class="dt-lede">
          Download it, point your tools at your Copilot plan, and get back to
          work. Then tell the rest of your team.
        </p>
        <div class="dt-cta">
          <a class="btn btn--primary" data-os="mac" href={macDmg} rel="noopener">
            <span class="btn-label">Download for macOS</span>
            {versionLabel && <span class="btn-meta" data-version-pill>{versionLabel}</span>}
          </a>
          <a class="btn" href={guideUrl}>
            <span class="btn-label">Read the guide</span>
            <span class="btn-meta" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="dt-footer">
      <a href={`${base}/`}>maximal</a>
      <a href={guideUrl}>Guide</a>
      <a href={repoUrl} rel="noopener">GitHub</a>
      <a href={releasesUrl} rel="noopener">Releases</a>
    </footer>

    <script>
      import "../lib/hydrate-downloads"
    </script>
    <script is:inline>
      (function () {
        var reel = document.getElementById("reel")
        if (!reel) return
        if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
        var real = reel.children.length - 1
        var n = 0
        setInterval(function () {
          n++
          reel.style.transition = "transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)"
          reel.style.setProperty("--n", String(n))
          if (n === real) {
            setTimeout(function () {
              reel.style.transition = "none"
              n = 0
              reel.style.setProperty("--n", "0")
            }, 640)
          }
        }, 2000)
      })()
    </script>

    <style>
      /* Wider measure than the home page — this is a confident, editorial page. */
      .topbar,
      .dt,
      .dt-footer {
        max-width: 74rem;
        margin: 0 auto;
      }

      .topbar {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 1.5rem 1.5rem 0;
      }
      .topbar__home {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        text-decoration: none;
      }
      .topbar__mark {
        display: inline-grid;
        place-items: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 5px;
        background: var(--brand);
        color: var(--brand-ink);
        font-family: var(--serif);
        font-weight: 700;
        font-size: 0.95rem;
        line-height: 1;
      }
      .topbar__word {
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }
      .topbar__tag {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--sans);
        font-size: 0.8rem;
        color: var(--text-muted);
      }
      .topbar__tag::before {
        content: "";
        width: 1px;
        height: 0.9rem;
        background: var(--border-strong);
      }

      .dt {
        padding: 3rem 1.5rem 4rem;
        display: flex;
        flex-direction: column;
        gap: clamp(3.5rem, 8vw, 6rem);
      }

      /* ===== Hero ===== */
      .dt-h1 {
        font-family: var(--serif);
        font-weight: 600;
        font-optical-sizing: auto;
        font-variation-settings: "SOFT" 30, "opsz" 110;
        font-size: clamp(2.4rem, 6.5vw, 5rem);
        line-height: 1.0;
        letter-spacing: -0.03em;
        color: var(--text);
        margin: 0;
        max-width: 16ch;
      }
      .dt-h1 .ink-brand {
        color: var(--brand-lit);
      }
      /* Tile drop-cap for the leading "m", baseline-matched to the word. */
      .hz-tile {
        display: inline-block;
        width: 1.6em;
        height: 1.6em;
        vertical-align: -0.544em;
        margin-right: 0.04em;
      }
      .hz-tile svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      .hz-tile__m {
        font-family: var(--serif);
        font-weight: 900;
        font-size: 72px;
        font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
      }
      .dt-hero__sub {
        font-family: var(--sans);
        font-size: 1.2rem;
        line-height: 1.55;
        color: var(--text-body);
        max-width: 34rem;
        margin: 1.6rem 0 0;
      }
      .dt-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
      }

      /* ===== Evidence — text | chart ===== */
      .dt-evidence {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
      }
      @media (max-width: 820px) {
        .dt-evidence {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
      }
      .dt-eyebrow {
        font-family: var(--sans);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brand-lit);
        margin: 0 0 0.6rem;
      }
      .dt-h2 {
        font-family: var(--serif);
        font-weight: 600;
        font-size: clamp(1.7rem, 3.8vw, 2.6rem);
        line-height: 1.08;
        letter-spacing: -0.025em;
        color: var(--text);
        margin: 0;
        max-width: 18ch;
      }
      .dt-lede {
        font-family: var(--sans);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--text-body);
        max-width: 40rem;
        margin: 1rem 0 0;
      }
      .dt-chart {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.75rem;
      }

      /* ===== Rolodex reel ===== */
      .dt-reel__lead {
        font-family: var(--sans);
        font-size: 1.05rem;
        color: var(--text-muted);
        margin: 0 0 0.4rem;
      }
      .reel {
        height: 1.12em;
        overflow: hidden;
        font-family: var(--serif);
        font-weight: 700;
        font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
        font-size: clamp(2.8rem, 9vw, 6.5rem);
        line-height: 1.12;
        letter-spacing: -0.03em;
        color: var(--brand-lit);
      }
      .reel__list {
        list-style: none;
        margin: 0;
        padding: 0;
        transform: translateY(calc(var(--n, 0) * -1.12em));
      }
      .reel__list li {
        height: 1.12em;
      }
      .dt-reel__tail {
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(1.3rem, 3vw, 2rem);
        line-height: 1.25;
        color: var(--text);
        max-width: 26ch;
        margin: 0.5rem 0 0;
      }

      /* ===== Triad ===== */
      .dt-block {
        margin: 0;
      }
      .dt-triad {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2.5rem;
      }
      .dt-triad li {
        font-family: var(--serif);
        font-weight: 600;
        font-size: clamp(1.25rem, 2.6vw, 1.8rem);
        letter-spacing: -0.015em;
        color: var(--text);
        position: relative;
        padding-left: 1.4rem;
      }
      .dt-triad li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.62em;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 2px;
        background: var(--brand);
      }

      /* ===== Close ===== */
      .dt-close {
        border-top: 1px solid var(--border);
        padding-top: clamp(3rem, 6vw, 4rem);
      }
      .dt-h2--close {
        font-size: clamp(2rem, 5vw, 3.4rem);
        max-width: 18ch;
      }
      .dt-close .dt-cta {
        margin-top: 1.75rem;
      }

      .dt-footer {
        padding: 2rem 1.5rem 3rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        font-family: var(--sans);
        font-size: 0.9rem;
      }
      .dt-footer a {
        color: var(--text-muted);
        text-decoration: none;
      }
      .dt-footer a:hover {
        color: var(--text);
      }
    </style>
  </body>
</html>
