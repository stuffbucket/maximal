---
import GuideLayout from "../../layouts/GuideLayout.astro";
import { GUIDE_NAV } from "../../lib/guide";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const description =
  "Install maximal, connect it to your GitHub Copilot plan, and point your AI coding tools at it.";
---

<GuideLayout title="Guide" description={description} bare>
  <header class="guide-index__head">
    <h1 class="guide-index__title">maximal guide</h1>
    <p class="guide-index__lead">
      Get maximal running on your GitHub Copilot plan and point your tools at it.
      Seven short pages, roughly in order.
    </p>
  </header>

  <ol class="guide-cards">
    {
      GUIDE_NAV.map((p, i) => (
        <li>
          <a class="guide-card" href={`${base}/guide/${p.slug}`}>
            <span class="guide-card__num">{String(i + 1).padStart(2, "0")}</span>
            <span class="guide-card__body">
              <span class="guide-card__title">{p.title}</span>
              <span class="guide-card__blurb">{p.blurb}</span>
            </span>
            <span class="guide-card__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </li>
      ))
    }
  </ol>

  <style>
    .guide-index__head {
      margin-bottom: 2.25rem;
    }
    .guide-index__title {
      font-family: var(--serif);
      font-weight: 600;
      font-optical-sizing: auto;
      font-variation-settings: "SOFT" 30, "opsz" 96;
      font-size: clamp(2.25rem, 5vw, 3.25rem);
      line-height: 1.05;
      letter-spacing: -0.025em;
      color: var(--text);
      margin: 0 0 0.75rem;
    }
    .guide-index__lead {
      font-family: var(--sans);
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--text-body);
      max-width: 46ch;
      margin: 0;
    }

    .guide-cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    @media (max-width: 640px) {
      .guide-cards {
        grid-template-columns: 1fr;
      }
    }

    .guide-card {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      height: 100%;
      padding: 1rem 1.15rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      text-decoration: none;
      color: inherit;
      box-shadow: var(--shadow-card);
      transition:
        border-color 150ms ease-out,
        transform 150ms ease-out,
        background 150ms ease-out;
    }
    .guide-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .guide-card:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .guide-card__num {
      flex: 0 0 auto;
      font-family: var(--serif);
      font-weight: 600;
      font-size: 1.05rem;
      line-height: 1.4;
      color: var(--accent);
      font-variant-numeric: tabular-nums;
    }
    .guide-card__body {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      flex: 1 1 auto;
      min-width: 0;
    }
    .guide-card__title {
      font-family: var(--sans);
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--text);
    }
    .guide-card__blurb {
      font-family: var(--sans);
      font-size: 0.9rem;
      line-height: 1.45;
      color: var(--text-muted);
    }
    .guide-card__arrow {
      flex: 0 0 auto;
      align-self: center;
      color: var(--text-muted);
      transition: color 150ms ease-out;
    }
    .guide-card:hover .guide-card__arrow {
      color: var(--accent);
    }
  </style>
</GuideLayout>
