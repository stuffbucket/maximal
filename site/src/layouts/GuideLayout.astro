---
import "../styles/global.css";
import { GUIDE_NAV } from "../lib/guide";

interface Props {
  title: string;
  slug?: string;
  description?: string;
  bare?: boolean;
}
const { title, slug, description, bare } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (s: string) => `${base}/guide/${s}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/fraunces-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/commissioner-latin.woff2"
      crossorigin
    />
    <title>{title} · maximal</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class="guide-shell">
      <aside class="guide-sidebar">
        <a class="guide-home" href={`${base}/`}>
          <span class="guide-home__mark" aria-hidden="true">m</span>
          <span class="guide-home__word">maximal</span>
        </a>
        <nav class="guide-nav" aria-label="User guide">
          <p class="guide-nav__label">Guide</p>
          <ul>
            {
              GUIDE_NAV.map((p) => (
                <li>
                  <a
                    href={href(p.slug)}
                    aria-current={p.slug === slug ? "page" : undefined}
                  >
                    {p.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <main id="main" class="guide-main">
        {
          bare ? (
            <slot />
          ) : (
            <article class="prose">
              <slot />
            </article>
          )
        }
      </main>
    </div>

    <style>
      .guide-shell {
        display: grid;
        grid-template-columns: 15rem minmax(0, 1fr);
        gap: 3rem;
        max-width: 62rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
        align-items: start;
      }
      @media (max-width: 820px) {
        .guide-shell {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          padding: 1.5rem 1.25rem 4rem;
        }
      }

      .guide-sidebar {
        position: sticky;
        top: 2.5rem;
      }
      @media (max-width: 820px) {
        .guide-sidebar {
          position: static;
        }
      }

      .guide-home {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        margin-bottom: 1.75rem;
      }
      .guide-home__mark {
        display: inline-grid;
        place-items: center;
        width: 1.7rem;
        height: 1.7rem;
        border-radius: 6px;
        background: var(--brand);
        color: var(--brand-ink);
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1.05rem;
        line-height: 1;
      }
      .guide-home__word {
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1.2rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      .guide-nav__label {
        font-family: var(--sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin: 0 0 0.6rem;
      }
      .guide-nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.15rem;
      }
      .guide-nav a {
        display: block;
        padding: 0.4rem 0.6rem;
        border-radius: var(--radius-sm);
        font-family: var(--sans);
        font-size: 0.95rem;
        color: var(--text-body);
        text-decoration: none;
        transition: background 150ms ease-out, color 150ms ease-out;
      }
      .guide-nav a:hover {
        background: var(--surface-2);
        color: var(--text);
      }
      .guide-nav a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .guide-nav a[aria-current="page"] {
        background: var(--surface-2);
        color: var(--accent-text);
        font-weight: 500;
      }

      .guide-main {
        min-width: 0;
      }

      /* ===== Prose ===== */
      .prose {
        max-width: 42rem;
      }
      .prose :global(h1) {
        font-family: var(--serif);
        font-weight: 600;
        font-optical-sizing: auto;
        font-variation-settings: "SOFT" 30, "opsz" 96;
        font-size: clamp(2rem, 4vw, 2.75rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--text);
        margin: 0 0 1.25rem;
      }
      .prose :global(h2) {
        font-family: var(--serif);
        font-weight: 600;
        font-size: clamp(1.4rem, 3vw, 1.7rem);
        line-height: 1.2;
        letter-spacing: -0.015em;
        color: var(--text);
        margin: 2.5rem 0 0.85rem;
      }
      .prose :global(h3) {
        font-family: var(--sans);
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text);
        margin: 1.75rem 0 0.6rem;
      }
      .prose :global(p),
      .prose :global(li) {
        color: var(--text-body);
        line-height: 1.65;
      }
      .prose :global(p) {
        margin: 0 0 1rem;
      }
      .prose :global(ul),
      .prose :global(ol) {
        margin: 0 0 1rem;
        padding-left: 1.4rem;
      }
      .prose :global(li) {
        margin: 0.35rem 0;
      }
      .prose :global(li::marker) {
        color: var(--text-muted);
      }
      .prose :global(a) {
        color: var(--link);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1.5px;
        transition: color 150ms ease-out;
      }
      .prose :global(a:hover) {
        color: var(--link-hover);
      }
      .prose :global(strong) {
        color: var(--text);
        font-weight: 600;
      }
      .prose :global(code) {
        font-family: var(--mono);
        font-size: 0.875em;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--radius-chip);
        padding: 0.05em 0.4em;
        color: var(--text);
      }
      .prose :global(pre) {
        font-family: var(--mono);
        font-size: 0.85rem;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 0.9rem 1.1rem;
        overflow-x: auto;
        margin: 0 0 1.25rem;
        line-height: 1.5;
      }
      .prose :global(pre code) {
        background: transparent;
        border: 0;
        padding: 0;
      }
      .prose :global(blockquote) {
        margin: 0 0 1.25rem;
        padding: 0.25rem 0 0.25rem 1rem;
        border-left: 2px solid var(--accent);
        color: var(--text-body);
      }
      .prose :global(blockquote p:last-child) {
        margin-bottom: 0;
      }
      .prose :global(hr) {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
      }
      .prose :global(:is(h1, h2, h3) + p) {
        margin-top: 0;
      }
    </style>
  </body>
</html>
