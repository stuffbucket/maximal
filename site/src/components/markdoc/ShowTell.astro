---
// The explainer "island": a value SENTENCE (with the crimson app-tile as a
// drop-cap "m"), a directional tools → models RAIL, and a bold PAYOFF. This
// replaces the old symmetric brace diagram, which grouped but never showed the
// verb or the direction. Presentational.

// Brand marks from Simple Icons (CC0). `fill: true` = solid logo whose path
// carries its own fill="currentColor"; `fill: false` = a monoline stroke glyph.
const icon: Record<string, { fill: boolean; markup: string }> = {
  claude: {
    fill: true,
    markup: `<path d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z" fill="currentColor"/>`,
  },
  openai: {
    fill: true,
    markup: `<path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z" fill="currentColor"/>`,
  },
  gemini: {
    fill: true,
    markup: `<path d="M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81" fill="currentColor"/>`,
  },
  opencode: {
    fill: true,
    markup: `<path fill-rule="evenodd" d="M22 24H2V0h20zM17 4.8H7v14.4h10z" fill="currentColor"/>`,
  },
  sdk: {
    fill: false,
    markup: `<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 10l2.5 2.5L7 15"/><path d="M12.5 15.5H17"/>`,
  },
  more: {
    fill: true,
    markup: `<circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>`,
  },
};

// Trimmed to ~4 per side (no duplicate Claude/OpenAI rows) so the categories
// read at a glance: apps you run on the left, models that answer on the right.
const tools = [
  { name: "Claude Code", icon: "claude" },
  { name: "Codex", icon: "openai" },
  { name: "opencode", icon: "opencode" },
  { name: "any Anthropic / OpenAI SDK", icon: "sdk" },
];
const models = [
  { name: "Claude Opus 5", icon: "claude" },
  { name: "GPT-5.6", icon: "openai" },
  { name: "Gemini 3 Pro", icon: "gemini" },
  { name: "…and more", icon: "more" },
];

// Served from site/public/screenshots/ (base-prefixed for GitHub Pages).
const shot = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/screenshots/app-dashboard.png`;
---

<section id="how" class="showtell">
  <div class="flow-lede">
    <h2 class="flow-lede__text">
      <span class="lede-initial" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <rect width="100" height="100" rx="23" fill="#c8334a"></rect>
          <text class="lede-initial__m" x="50" y="66" text-anchor="middle"
            fill="#f4ead4">m</text>
        </svg></span
      ><span class="sr-only">m</span>aximalize
      <span class="ink-brand">your AI ecosystem</span>
    </h2>
    <p class="flow-lede__how">
      Switch on the tools you use, and maximal runs them on the models in your
      Copilot plan.
    </p>
  </div>

  <div class="flow-rail">
    <div class="flow-rail__group">
      <span class="flow-rail__cap">the tools you use</span>
      <ul class="flow-rail__chips">
        {
          tools.map((t) => (
            <li class="flow-chip">
              <svg
                class="flow__ic"
                viewBox="0 0 24 24"
                fill={icon[t.icon].fill ? "currentColor" : "none"}
                stroke={icon[t.icon].fill ? "none" : "currentColor"}
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icon[t.icon].markup}
              />
              <span>{t.name}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <span class="flow-rail__arrow ink-brand" aria-hidden="true">&#8594;</span>

    <div class="flow-rail__group">
      <span class="flow-rail__cap">your Copilot models</span>
      <ul class="flow-rail__chips">
        {
          models.map((m) => (
            <li class="flow-chip">
              <svg
                class="flow__ic"
                viewBox="0 0 24 24"
                fill={icon[m.icon].fill ? "currentColor" : "none"}
                stroke={icon[m.icon].fill ? "none" : "currentColor"}
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icon[m.icon].markup}
              />
              <span>{m.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="flow-payoff">Nothing new to set up. No second bill.</p>

  <div class="flow-notes">
    <p>
      <b>No new API key.</b> Your tools think they're talking to Anthropic or OpenAI
      — it's your GitHub Copilot plan answering.
    </p>
    <p>
      <b>No second bill.</b> It's the Copilot plan you already pay for — GitHub Enterprise
      too.
    </p>
  </div>

  <figure class="appshot">
    <div class="appshot__frame">
      <img
        src={shot}
        alt="maximal's usage dashboard showing token usage broken down by model across your tools over the last 30 days"
        width="1600"
        height="1105"
        loading="lazy"
        decoding="async"
      />
    </div>
    <figcaption class="appshot__cap">
      Every tool, every model, every token. See exactly where your Copilot
      subscription goes.
    </figcaption>
  </figure>
</section>

<style>
  /* The value headline (the section's h2) — the crimson app tile is fused in as
     the initial "m" of "maximalize". Reset the global h2's variation axes so the
     display face renders with default optical sizing, matching the rest. */
  .flow-lede {
    margin: 0 auto;
  }
  .lede-initial {
    display: inline-block;
    width: 1.6em;
    height: 1.6em;
    /* Drop the tile so the cream glyph's baseline (y=66/100 in the SVG) lands on
       the text baseline: below-baseline space = 34% of tile height. */
    vertical-align: -0.544em;
    margin-right: 0.05em;
  }
  .lede-initial svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .lede-initial__m {
    font-family: var(--serif);
    font-weight: 900;
    font-size: 72px;
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
  }
  .flow-lede__text {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    font-variation-settings: normal;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
    text-align: center;
    text-wrap: balance;
    max-width: 24ch;
    margin: 0 auto;
  }
  /* The "how" — a quiet sans sub-line that bridges the coined-verb headline into
     the tools → models rail below. */
  .flow-lede__how {
    font-family: var(--sans);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--text-muted);
    text-align: center;
    text-wrap: balance;
    max-width: 42ch;
    margin: 1rem auto 0;
  }

  /* Directional rail — apps on the left, a single crimson arrow, models on the
     right, in balanced columns. The arrow is the only colour. */
  .flow-rail {
    display: grid;
    grid-template-columns: auto auto auto;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    margin: 2.75rem auto 0;
  }
  .flow-rail__group {
    display: grid;
    gap: 0.6rem;
  }
  .flow-rail__cap {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .flow-rail__chips {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .flow-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--sans);
    font-size: 0.925rem;
    color: var(--text-body);
    line-height: 1.2;
  }
  .flow__ic {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: var(--text-muted);
  }
  .flow-rail__arrow {
    font-size: 1.75rem;
    line-height: 1;
    justify-self: center;
  }

  /* Payoff — bold Fraunces line, then two flat crimson-ruled notes (not cards). */
  .flow-payoff {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--text);
    text-align: center;
    margin: 2.75rem 0 0;
  }
  .flow-notes {
    max-width: 62ch;
    margin: 1.5rem auto 0;
    display: grid;
    gap: 1rem;
  }
  .flow-notes p {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--brand-lit);
    color: var(--text-body);
    font-size: 1rem;
    line-height: 1.55;
  }
  .flow-notes b {
    color: var(--text);
    font-weight: 600;
  }

  .appshot {
    margin: 2.75rem 0 0;
  }
  .appshot__frame {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    line-height: 0;
  }
  .appshot__frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .appshot__cap {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-align: center;
  }

  /* Stack the rail and turn the arrow to point DOWN so the story survives on
     narrow screens (the old braces vanished here). */
  @media (max-width: 720px) {
    .flow-rail {
      grid-template-columns: 1fr;
      gap: 1rem;
      max-width: 22rem;
    }
    .flow-rail__arrow {
      transform: rotate(90deg);
    }
  }
</style>
