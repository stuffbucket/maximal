---
// Get started in 3 steps. Step 1 carries the actual download (macOS live,
// Windows "coming soon"); the standalone download section folded in here.
// Homebrew + other install options live in the repo README.
import { getDownloadInfo } from "../../lib/downloads";

const { macDmg, winSetup, hasWindows, versionLabel, releasesUrl, repoUrl } =
  await getDownloadInfo();
const readmeUrl = `${repoUrl}#readme`;

const M = `<span class="brandword">maximal</span>`;
// Step screenshots are served from site/public/screenshots/ (base-prefixed for
// GitHub Pages), matching ShowTell's app-dashboard shot.
const shotBase = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/screenshots`;
const steps = [
  {
    title: "Install maximal",
    body: hasWindows
      ? "Grab the desktop app for macOS or Windows and open it — it runs quietly in the background."
      : "Grab the macOS desktop app and open it. Windows is coming soon.",
  },
  {
    title: "Sign in with GitHub",
    body: "One click connects your GitHub Copilot plan. No new account, no extra cost.",
    shot: {
      src: `${shotBase}/account-signin.png`,
      alt: "maximal's Account panel showing 'Not signed in' with a Sign in to GitHub button.",
      width: 2000,
      height: 1065,
    },
  },
  {
    title: "Pick your tools",
    body: `Point Claude Code, Codex, or opencode at ${M}. They run on your Copilot models.`,
    shot: {
      src: `${shotBase}/apps.png`,
      alt: "maximal's Apps panel with one-click toggles for Claude Code and Claude Desktop pointed at maximal.",
      width: 2000,
      height: 1175,
    },
  },
];
---

<section id="start" class="getstarted">
  <header class="getstarted__head">
    <h2>Get started</h2>
    <p class="getstarted__sub">Up and running in three steps.</p>
  </header>

  <ol class="getstarted__steps">
    {
      steps.map((step, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">
            {i + 1}
          </span>
          <div class="step__body">
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text" set:html={step.body} />
            {step.shot && (
              <figure class="step__shot">
                <img
                  src={step.shot.src}
                  alt={step.shot.alt}
                  width={step.shot.width}
                  height={step.shot.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}
            {i === 0 && (
              <div class="step__install">
                <div
                  class="downloads"
                  role="group"
                  aria-label="Downloads by platform"
                >
                  <a
                    class="btn btn--primary"
                    data-os="mac"
                    href={macDmg}
                    rel="noopener"
                  >
                    <span class="btn-label">macOS</span>
                    {versionLabel && (
                      <span class="btn-meta" data-version-pill>
                        {versionLabel}
                      </span>
                    )}
                  </a>
                  {hasWindows ? (
                    <a
                      class="btn btn--primary"
                      data-os="windows"
                      href={winSetup}
                      rel="noopener"
                    >
                      <span class="btn-label">Windows</span>
                      {versionLabel && (
                        <span class="btn-meta" data-version-pill>
                          {versionLabel}
                        </span>
                      )}
                    </a>
                  ) : (
                    <div
                      class="btn btn--soon"
                      data-os="windows"
                      aria-disabled="true"
                    >
                      <span class="btn-label">Windows</span>
                      <span class="btn-meta">coming soon</span>
                    </div>
                  )}
                </div>
                <p class="step__readme">
                  Homebrew and other options are in the{" "}
                  <a href={readmeUrl} rel="noopener">
                    README
                  </a>
                  {" · "}
                  <a href={releasesUrl} rel="noopener">
                    all releases
                  </a>
                  .
                </p>
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .getstarted__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1.75rem;
  }

  .getstarted__sub {
    font-family: var(--sans);
    color: var(--text-muted);
    margin: 0;
    flex-basis: 100%;
  }

  .getstarted__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .step:first-child {
    padding-top: 0;
    border-top: none;
  }

  .step__num {
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 0.9;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: lining-nums;
  }

  .step__title {
    font-family: var(--sans);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    margin: 0.15rem 0 0.4rem;
  }

  .step__text {
    font-family: var(--sans);
    color: var(--text-body);
    line-height: 1.55;
    margin: 0;
  }

  .step__install {
    margin-top: 1rem;
  }

  /* Step screenshots reuse ShowTell's framed-image treatment so the panels
     read as the same product surface across sections. */
  .step__shot {
    margin: 1rem 0 0;
    max-width: 30rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    line-height: 0;
  }
  .step__shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .step__readme {
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .step {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .step__num {
      font-size: 2.25rem;
    }
  }
</style>
