{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maximal",
  "version": "0.0.0",
  "identifier": "co.stuffbucket.maximal",
  "build": {
    "beforeDevCommand": "cd .. && bun run build:ui",
    "beforeBuildCommand": "cd .. && bun run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4REFCNzlFMkVCMUQ2QzQKUldURTFyRXVucmZhNk1KUFJDU1ZqdEt1WGZJWmpuUmtGYUxia1grYVk3QjZKQkNZS1Bob3lUOWsK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/maximal",
      "binaries/maximal-mcp-broker"
    ],
    "macOS": {
      "exceptionDomain": "localhost"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
