{
  "name": "@stuffbucket/maximal-storybook",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/prepare-ui.ts && storybook build --output-dir storybook-static --quiet",
    "contrast": "bun scripts/contrast-audit.ts",
    "prepare-ui": "bun scripts/prepare-ui.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/bun": "1.4.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "storybook": "10.6.4",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  }
}
