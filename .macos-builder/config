app_path = shell/src-tauri/target/release/bundle/macos/Maximal.app
volname = Maximal
bundle_id = co.stuffbucket.maximal
entitlements = bun-runtime
# The updater bundle is what the macOS app installs in place: a tarball of the
# notarized app plus its signature (Maximal's updater key, bound to the tag's
# version). release.yml's macos-dmg job waits for and verifies all three
# files, and the manifest job lists the tarball in updates/desktop/<channel>.json.
artifact = dmg,updater
updater_name = maximal-{tag}-darwin-arm64.app.tar.gz

# The builder signs both nested Bun sidecars after the isolated producer exits.
sign_nested = Contents/MacOS/maximal:bun-runtime,Contents/MacOS/maximal-mcp-broker:bun-runtime
