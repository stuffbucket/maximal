{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/dev/*.ts",
        "shell/src/dashboard/live/flow-worker.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "prettier-plugin-packagejson",
        "undici",
        "@stryker-mutator/command-runner"
      ],
      "playwright": {
        "entry": [
          "tests/e2e/**/*.spec.ts"
        ]
      }
    },
    "packages/plugin-*": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/connector-kit": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/figjam-plugin": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/figjam-bridge": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/figjam-layout": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "mise",
    "trufflehog"
  ],
  "ignoreExportsUsedInFile": true
}
